{
  "name": "candide-contracts",
  "version": "0.1.0-alpha.0",
  "description": "Safe{Core} Protocol modules",
  "author": "candide.labs",
  "license": "LGPL-3.0",
  "type": "module",
  "scripts": {
    "build": "hardhat build",
    "clean": "hardhat clean",
    "test": "hardhat test",
    "test:gas": "hardhat test --gas-stats",
    "coverage": "hardhat test --coverage",
    "fmt:sol": "prettier 'contracts/**/*.sol' -w",
    "fmt:ts": "prettier '{test,deploy,rocketh}/**/*.ts' hardhat.config.ts chains.ts -w",
    "fmt": "yarn fmt:ts && yarn fmt:sol",
    "lint": "yarn lint:sol && yarn lint:ts",
    "lint:sol": "solhint 'contracts/**/*.sol'",
    "lint:ts": "eslint '{test,deploy,rocketh}/**/*.ts' hardhat.config.ts chains.ts --max-warnings 0 --fix",
    "deploy": "hardhat deploy --network",
    "prepack": "yarn build"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.2.1",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.13",
    "@nomicfoundation/hardhat-ignition": "^3.1.9",
    "@nomicfoundation/hardhat-ignition-ethers": "^3.1.6",
    "@nomicfoundation/hardhat-keystore": "^3.1.2",
    "@nomicfoundation/hardhat-mocha": "^4.0.1",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.12",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@nomicfoundation/hardhat-typechain": "^3.1.3",
    "@nomicfoundation/hardhat-verify": "^3.1.4",
    "@nomicfoundation/ignition-core": "^3.1.11",
    "@rocketh/deploy": "^0.22.5",
    "@rocketh/node": "^0.22.4",
    "@rocketh/read-execute": "^0.23.1",
    "@safe-global/mock-contract": "^4.1.0",
    "@safe-global/safe-singleton-factory": "^2.0.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^5.60.1",
    "@typescript-eslint/parser": "^5.60.1",
    "chai": "^6.3.0",
    "dotenv": "^16.3.1",
    "eslint": "^8.43.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-no-only-tests": "^3.1.0",
    "eslint-plugin-prettier": "^4.2.1",
    "ethers": "^6.17.0",
    "hardhat": "^3.21.1",
    "hardhat-deploy": "^2.3.0",
    "mocha": "^12.0.3",
    "prettier": "^2.8.8",
    "prettier-plugin-solidity": "^1.1.3",
    "rocketh": "^0.26.2",
    "solhint": "^3.4.1",
    "solhint-plugin-prettier": "^0.0.5",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@account-abstraction": "git+https://github.com/eth-infinitism/account-abstraction.git#v0.6.0",
    "@openzeppelin/contracts": "^4.9.1",
    "@safe-global/safe-contracts": "^1.4.1-build.0"
  }
}

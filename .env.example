# Copy to .env and fill in what you need. Secrets can live in the Hardhat keystore instead
# (npx hardhat keystore set <NAME>); values in the environment take priority over the keystore.

# Deployer account (secret; keystore recommended).
DEPLOYER_PRIVATE_KEY=

# A complete RPC url per network. Required for networks without a `node` in chains.ts (most
# mainnets); for the others it overrides the public `node`, and must then be in this file, e.g.:
# RPC_URL_1=
# RPC_URL_8453=
# RPC_URL_11155111=

# Explorer verification: one Etherscan v2 key covers every Etherscan-family explorer.
ETHERSCAN_API_KEY=

# Deploy only the SocialRecoveryModule variant with this recovery period, in seconds. Unset, every
# pinned variant allowed on the network is deployed.
# SCM_RECOVERY_PERIOD_ARG=
